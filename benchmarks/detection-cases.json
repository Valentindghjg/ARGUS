{
  "version": 1,
  "about": "Invented messages for the ARGUS detection benchmark (plan G5). Every address and text is synthetic; no case comes from a real mailbox. 'truth' says what the message really shows, 'expect' what ARGUS does with it today. Where both differ, 'limit' explains the known gap. The result is not proof of accuracy on real mailboxes.",
  "own": ["owner@example.invalid", "second@example.invalid"],
  "cases": [
    {"id": "created-en", "group": "account events", "truth": "account",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Your account has been created", "body": "Welcome aboard."},
     "expect": {"outcome": "probable", "signal": "account_created", "assigned": true}},
    {"id": "created-de", "group": "account events", "truth": "account",
     "mail": {"from": "service@zalando.de", "to": ["own"], "subject": "Willkommen", "body": "Dein Konto wurde erfolgreich erstellt."},
     "expect": {"outcome": "probable", "signal": "account_created", "assigned": true}},
    {"id": "password-changed-en", "group": "account events", "truth": "account",
     "mail": {"from": "no-reply@dropbox.com", "to": ["own"], "subject": "Security notice", "body": "Your password has been changed."},
     "expect": {"outcome": "probable", "signal": "password_changed", "assigned": true}},
    {"id": "password-changed-de", "group": "account events", "truth": "account",
     "mail": {"from": "service@paypal.com", "to": ["own"], "subject": "Sicherheitshinweis", "body": "Dein Passwort wurde gerade geändert."},
     "expect": {"outcome": "probable", "signal": "password_changed", "assigned": true}},
    {"id": "email-verified", "group": "account events", "truth": "account",
     "mail": {"from": "noreply@discord.com", "to": ["own"], "subject": "All set", "body": "Your email address has been verified."},
     "expect": {"outcome": "probable", "signal": "email_verified", "assigned": true}},
    {"id": "login-en", "group": "account events", "truth": "account",
     "mail": {"from": "info@account.netflix.com", "to": ["own"], "subject": "New sign-in to your account", "body": "We noticed a new sign-in."},
     "expect": {"outcome": "probable", "signal": "login_activity", "assigned": true}},
    {"id": "login-de", "group": "account events", "truth": "account",
     "mail": {"from": "noreply@ebay.de", "to": ["own"], "subject": "Neue Anmeldung", "body": "Neue Anmeldung bei deinem Konto von einem neuen Gerät."},
     "expect": {"outcome": "probable", "signal": "login_activity", "assigned": true}},
    {"id": "welcome-with-unsubscribe-footer", "group": "account events", "truth": "account",
     "mail": {"from": "hello@duolingo.com", "to": ["own"], "subject": "Welcome", "body": "Welcome! Your new account is ready to use.", "list": true},
     "expect": {"outcome": "probable", "signal": "welcome_account", "assigned": true}},
    {"id": "registration-html-subdomain", "group": "account events", "truth": "account",
     "mail": {"from": "team@mail.notion.so", "to": ["own"], "subject": "Hello", "body": "Thank you for signing up.", "html": true},
     "expect": {"outcome": "probable", "signal": "account_created", "assigned": true}},
    {"id": "verification-requested", "group": "account events", "truth": "unclear",
     "note": "A sign-up was started; whether it was completed is unknown.",
     "mail": {"from": "noreply@strava.com", "to": ["own"], "subject": "Verify your email", "body": "Please confirm the address."},
     "expect": {"outcome": "probable", "signal": "verification_requested", "assigned": true}},

    {"id": "newsletter", "group": "not an account", "truth": "no_account",
     "mail": {"from": "news@spotify.com", "to": ["own"], "subject": "Our spring sale", "body": "Special offers for everyone.", "list": true},
     "expect": {"outcome": "weak", "signal": "newsletter", "assigned": false}},
    {"id": "newsletter-confirmation", "group": "not an account", "truth": "no_account",
     "mail": {"from": "news@spotify.com", "to": ["own"], "subject": "Confirm your newsletter subscription", "body": "Please confirm your email."},
     "expect": {"outcome": "weak", "signal": "newsletter", "assigned": false}},
    {"id": "guest-order", "group": "not an account", "truth": "unclear",
     "note": "An order is possible without an account (guest checkout).",
     "mail": {"from": "orders@zalando.de", "to": ["own"], "subject": "Deine Bestellung", "body": "Danke für deinen Einkauf."},
     "expect": {"outcome": "weak", "signal": "order_only", "assigned": false}},
    {"id": "reset-request", "group": "not an account", "truth": "unclear",
     "note": "Anyone can request a reset for any address.",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Reset your password", "body": "Use the link to continue."},
     "expect": {"outcome": "weak", "signal": "reset_requested", "assigned": false}},
    {"id": "negated-creation", "group": "not an account", "truth": "no_account",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Sign-up incomplete", "body": "Your account was not created."},
     "expect": {"outcome": "none"}},
    {"id": "addressed-to-someone-else", "group": "not an account", "truth": "no_account",
     "mail": {"from": "noreply@github.com", "to": ["other"], "subject": "Your account has been created", "body": "Welcome aboard."},
     "expect": {"outcome": "none"}},
    {"id": "sent-by-yourself", "group": "not an account", "truth": "no_account",
     "mail": {"from": "own", "to": ["second"], "subject": "Your account has been created", "body": "Copy of a note."},
     "expect": {"outcome": "none"}},

    {"id": "lookalike-domain", "group": "spoofing and shared senders", "truth": "no_account",
     "note": "Held for review as an unknown domain; never linked to the real provider.",
     "mail": {"from": "security@github.com.account-check.example", "to": ["own"], "subject": "Your password has been changed", "body": "Sign in to undo."},
     "expect": {"outcome": "unknown_domain", "signal": "password_changed", "assigned": false}},
    {"id": "shared-sending-service", "group": "spoofing and shared senders", "truth": "unclear",
     "note": "A bulk-mail platform sends for many companies; the list marks it as a shared sender.",
     "mail": {"from": "bounce@em123.sendgrid.net", "to": ["own"], "subject": "Your account has been created", "body": "Welcome aboard."},
     "expect": {"outcome": "unknown_domain", "signal": "account_created", "assigned": false}},
    {"id": "spoofed-catalog-sender", "group": "spoofing and shared senders", "truth": "no_account",
     "limit": "ARGUS does not check sender authentication (SPF, DKIM). A forged sender address of a catalog provider looks genuine; your review decides.",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Your account has been created", "body": "Forged by a third party."},
     "expect": {"outcome": "probable", "signal": "account_created", "assigned": true}},
    {"id": "unknown-provider", "group": "spoofing and shared senders", "truth": "account",
     "note": "Held for review until the domain is added to the catalog.",
     "mail": {"from": "hello@new-service.example", "to": ["own"], "subject": "Your account has been created", "body": "Welcome aboard."},
     "expect": {"outcome": "unknown_domain", "signal": "account_created", "assigned": false}},

    {"id": "forwarded", "group": "addresses and forwarding", "truth": "account",
     "note": "Forwarding hides which address signed up; the clue is kept but weak.",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Fwd: Your account has been created", "body": "Forwarded message."},
     "expect": {"outcome": "weak", "signal": "account_created", "assigned": false}},
    {"id": "two-own-recipients", "group": "addresses and forwarding", "truth": "account",
     "note": "Two own addresses received it; the sign-in address stays open.",
     "mail": {"from": "noreply@github.com", "to": ["own", "second"], "subject": "Your account has been created", "body": "Welcome aboard."},
     "expect": {"outcome": "weak", "signal": "account_created", "assigned": false}},
    {"id": "copy-only", "group": "addresses and forwarding", "truth": "unclear",
     "note": "Only a copy (Cc) reached the own address.",
     "mail": {"from": "noreply@github.com", "to": ["other"], "cc": ["own"], "subject": "Your account has been created", "body": "Welcome aboard."},
     "expect": {"outcome": "weak", "signal": "account_created", "assigned": false}},
    {"id": "headers-only", "group": "addresses and forwarding", "truth": "account",
     "note": "A message over the size limit is judged by its headers; the score is capped.",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Your account has been created", "body": "", "headers_only": true},
     "expect": {"outcome": "probable", "signal": "account_created", "assigned": true}},

    {"id": "other-language", "group": "language and wording", "truth": "account",
     "limit": "The rules know English and German wording only.",
     "mail": {"from": "noreply@github.com", "to": ["own"], "subject": "Bienvenue", "body": "Votre compte a été créé."},
     "expect": {"outcome": "none"}},
    {"id": "unusual-wording", "group": "language and wording", "truth": "account",
     "limit": "Uncommon phrases are missed; the rules cover typical account messages.",
     "mail": {"from": "noreply@spotify.com", "to": ["own"], "subject": "You're in", "body": "Thanks for joining us. Start listening now."},
     "expect": {"outcome": "none"}}
  ]
}
